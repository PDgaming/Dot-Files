#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]

(
    default_album_art_path: None,
    show_song_table_header: true,
    draw_borders: true,
    browser_column_widths: [20, 30, 60],
    symbols: (song: "󰎈 ",dir: "󰉋 ",marker: " ",ellipsis: "..."),
    text_color: "#cdd6f4",
    tab_bar: (
        enabled: true,
        active_style: (bg:"#1E1E2E" ,fg: "#FAB387", modifiers: "Bold"),
        inactive_style: (fg: "#7f849c", modifiers: ""),
    ),
    highlighted_item_style: (fg: "#A6E3A1", modifiers: "Bold"),
    current_item_style: (fg: "#89B4FA", bg: "#1E1E2E", modifiers: "Bold"),
    borders_style: (fg: "#6c7086", modifiers: "Bold"),
    highlight_border_style: (fg: "#f9e2af"),
    progress_bar: (
        symbols: ["┄", "┅", "━"],
        track_style: (fg: "#313244"),
        elapsed_style: (fg: "#FAB387"),
        thumb_style: (fg: "#89B4FA"),
    ),
    scrollbar: (
        symbols: ["", "", "", ""],
        track_style: (fg: "#6c7086"),
        ends_style: (fg: "#6c7086"),
        thumb_style: (fg: "#f9e2af"),
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
            (kind: Property(Title)),
            (kind: Text(" - ")),
            (kind: Property(Artist)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    song_table_format: [
        (
            prop: (kind: Property(Title), style: (fg: "#94e2d5"),
                highlighted_item_style: (fg: "#1e1e2e", modifiers: "Bold"),
                default: (kind: Property(Filename), style: (fg: "#6c7086"),)
            ),
            width: "50%",
        ),
        (
            prop: (kind: Property(Artist), style: (fg: "#f5c2e7"),
                default: (kind: Text("Unknown Artist"), style: (fg: "#7f849c"))
            ),
            width: "45%",
        ),
        (
            prop: (kind: Property(Duration), style: (fg: "#f9e2af")),
            width: "10%",
            alignment: Right,
        ),
    ],
    header: (
        rows: [
            (
                left: [
                    (kind: Property(Status(StateV2(playing_label: " 🔊", paused_label: " ❚❚", stopped_label: " ⏹️"))), style: (fg: "#94e2d5", modifiers: "Bold")),
                ],
                center: [
                    (kind: Property(Song(Title)), style: (fg: "#cdd6f4",modifiers: "Bold"),
                        default: (kind: Property(Song(Filename)), style: (fg: "#cdd6f4",modifiers: "Bold"))
                    )
                ],
                right: [
                    (kind: Text("Vol: "), style: (fg: "#f9e2af", modifiers: "Bold")),
                    (kind: Property(Status(Volume)), style: (fg: "#f9e2af", modifiers: "Bold")),
                    (kind: Text("% "), style: (fg: "#f9e2af", modifiers: "Bold"))
                ]
            ),
            (
                left: [
                    (kind: Property(Status(Elapsed)),style: (fg: "#cdd6f4")),
                    (kind: Text("/"),style: (fg: "#6c7086")),
                    (kind: Property(Status(Duration)),style: (fg: "#cdd6f4")),
                ],
                center: [
                    (kind: Property(Song(Artist)), style: (fg: "#f5c2e7", modifiers: "Bold"),
                        default: (kind: Text("Unknown Artist"), style: (fg: "#f38ba8", modifiers: "Bold"))
                    ),
                ],
                right: [
                    (
                        kind: Property(Widget(States(
                            active_style: (fg: "#cba6f7", modifiers: "Bold"),
                            separator_style: (fg: "#7f849c")))
                        ),
                        style: (fg: "#7f849c")
                    ),
                ]
            ),
        ],
    ),
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "4",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                    (
                            size: "100%",
                            pane: Split(
                                direction: Vertical,
                                panes: [
                                (
                                        size: "4",
                                        borders: "ALL",
                                        pane: Pane(Header),
                                    ),
                                ]
                            )
                        ),
                    ]
                ),
            ),
            (
                size: "3",
                pane: Pane(Tabs),
            ),
            (
                size: "100%",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "100%",
                            borders: "NONE",
                            pane: Pane(TabContent),
                        ),
                    ]
                ),
            ),
            (
                size: "3",
                borders: "TOP | BOTTOM",
                pane: Pane(ProgressBar),
            ),
        ],
    ),
)
